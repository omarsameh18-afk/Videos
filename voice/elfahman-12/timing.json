     "sil_start": 12.2,
     "sil_dur": 0.22,
     "orig": 0.48
    }
   ]
  },
  {
   "i": 4,
   "text": "وفي نفس اللحظة، الأرض هتبطّل تلف حوالين الشمس، وهتطلع ماشية في خط مستقيم في الفضا.",
   "start": 14.78,
   "end": 20.55,
   "pauses": [
    {
     "sil_start": 15.67,
     "sil_dur": 0.24,
     "orig": 0.24
    },
    {
     "sil_start": 16.61,
     "sil_dur": 0.08,
     "orig": 0.08
    },
    {
     "sil_start": 17.99,
     "sil_dur": 0.22,
     "orig": 0.36
    },
    {
     "sil_start": 19.32,
     "sil_dur": 0.13,
     "orig": 0.13
    }
   ]
  },
  {
   "i": 5,
   "text": "بعد كام يوم، الزرع الصغير هيبدأ يموت، عشان مفيش نور يعمل بيه أكله.",
   "start": 20.97,
   "end": 25.2,
   "pauses": [

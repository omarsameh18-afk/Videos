     "sil_dur": 0.19,
     "orig": 0.19
    }
   ]
  },
  {
   "i": 9,
   "text": "والشجر الكبير؟ هيفضل عايش عشرات السنين، عشان شايل أكل جواه زي المخزن.",
   "start": 39.05,
   "end": 44.17,
   "pauses": [

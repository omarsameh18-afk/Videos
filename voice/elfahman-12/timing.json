     "sil_start": 43.37,
     "sil_dur": 0.11,
     "orig": 0.11
    }
   ]
  },
  {
   "i": 10,
   "text": "طب يعني كده الحياة خلصت خالص؟",
   "start": 44.59,
   "end": 46.88,
   "pauses": [
    {

     "sil_start": 21.79,
     "sil_dur": 0.19,
     "orig": 0.19
    },
    {
     "sil_start": 23.39,
     "sil_dur": 0.22,
     "orig": 0.48
    }
   ]
  },
  {
   "i": 6,
   "text": "بعد أسبوع، الدنيا كلها هتبقى تحت الصفر، أبرد من أي شتا عشته في حياتك.",
   "start": 25.62,
   "end": 30.64,
   "pauses": [
    {
     "sil_start": 26.4,
     "sil_dur": 0.22,
     "orig": 0.22

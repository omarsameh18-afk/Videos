{
 "duration": 72.03,
 "sentences": [
  {
   "i": 1,
   "text": "لو الشمس اختفت دلوقتي، مش هتحس بحاجة لمدة تمن دقايق!",
   "start": 0.0,
   "end": 3.34,
   "pauses": [

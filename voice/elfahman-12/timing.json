     "sil_start": 2.64,
     "sil_dur": 0.06,
     "orig": 0.13
    }
   ]
  },
  {
   "i": 2,
   "text": "وبعدها فجأة، الدنيا كلها هتضلم… والقمر كمان هيختفي من السما.",
   "start": 3.76,
   "end": 8.45,
   "pauses": [

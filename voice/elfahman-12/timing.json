     "sil_start": 6.45,
     "sil_dur": 0.35,
     "orig": 0.64
    }
   ]
  },
  {
   "i": 3,
   "text": "عشان نور الشمس بياخد حوالي تمن دقايق لحد ما يوصلنا، والقمر أصلاً بينوّر من نورها.",
   "start": 8.87,
   "end": 14.36,
   "pauses": [

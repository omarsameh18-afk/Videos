    {
     "sil_start": 29.35,
     "sil_dur": 0.16,
     "orig": 0.16
    }
   ]
  },
  {
   "i": 7,
   "text": "بعد كام شهر، البحار هتبدأ تتجمد من فوق.",
   "start": 31.06,
   "end": 33.81,
   "pauses": [
    {
     "sil_start": 31.87,
     "sil_dur": 0.21,
     "orig": 0.21
    }
   ]
  },
  {
   "i": 8,
   "text": "بعد سنة، الحرارة هتوصل لسالب سبعين، والنيل نفسه هيبقى تلج.",
   "start": 34.23,
   "end": 38.63,
   "pauses": [
    {

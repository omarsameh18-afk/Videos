{"fps": 30, "duration": 72.03, "frames": 2161, "sentences": [{"i": 1, "start": 0.0, "end": 3.34, "text": "لو الشمس اختفت دلوقتي، مش هتحس بحاجة لمدة ٨ دقايق!"}, {"i": 2, "start": 3.76, "end": 8.45, "text": "وبعدها فجأة، الدنيا كلها هتضلم… والقمر كمان هيختفي من السما."}, {"i": 3, "start": 8.87, "end": 14.36, "text": "عشان نور الشمس بياخد حوالي ٨ دقايق لحد ما يوصلنا، والقمر أصلاً بينوّر من نورها."}, {"i": 4, "start": 14.78, "end": 20.55, "text": "وفي نفس اللحظة، الأرض هتبطّل تلف حوالين الشمس، وهتطلع ماشية في خط مستقيم في الفضا."}, {"i": 5, "start": 20.97, "end": 25.2, "text": "بعد كام يوم، الزرع الصغير هيبدأ يموت، عشان مفيش نور يعمل بيه أكله."}, {"i": 6, "start": 25.62, "end": 30.64, "text": "بعد أسبوع، الدنيا كلها هتبقى تحت الصفر، أبرد من أي شتا عشته في حياتك."}, {"i": 7, "start": 31.06, "end": 33.81, "text": "بعد كام شهر، البحار هتبدأ تتجمد من فوق."}, {"i": 8, "start": 34.23, "end": 38.63, "text": "بعد سنة، الحرارة هتوصل لسالب سبعين، والنيل نفسه هيبقى تلج."}, {"i": 9, "start": 39.05, "end": 44.17, "text": "والشجر الكبير؟ هيفضل عايش عشرات السنين، عشان شايل أكل جواه زي المخزن."}, {"i": 10, "start": 44.59, "end": 46.88, "text": "طب يعني كده الحياة خلصت خالص؟"}, {"i": 11, "start": 47.68, "end": 48.99, "text": "استنى ده الغريب جاي!"}, {"i": 12, "start": 49.39, "end": 55.1, "text": "تحت التلج، مية البحر هتفضل سايلة آلاف السنين، عشان التلج نفسه هيدفّيها زي البطانية."}, {"i": 13, "start": 55.52, "end": 60.57, "text": "وفي قاع المحيط، فيه كائنات عايشة جنب براكين تحت المية، عمرها ما شافت الشمس أصلاً."}, {"i": 14, "start": 60.99, "end": 64.52, "text": "يعني لو الشمس اختفت… ممكن متاخدش بالها خالص!"}, {"i": 15, "start": 64.94, "end": 69.95, "text": "لو الشمس اختفت بكرة، أول حاجة هتعملها في الـ٨ دقايق دول إيه؟ اكتبهالي في الكومنتات."}, {"i": 16, "start": 70.37, "end": 71.63, "text": "الفهمان كسبان."}], "captions": [{"text": "لو الشمس اختفت", "start": 0, "end": 1.46, "s": 1}, {"text": "مش هتحس ٨ دقايق!", "start": 1.46, "end": 3.76, "s": 1}, {"text": "وبعدها فجأة،", "start": 3.76, "end": 4.9, "s": 2}, {"text": "الدنيا كلها هتضلم…", "start": 4.9, "end": 6.8, "s": 2}, {"text": "والقمر كمان هيختفي", "start": 6.8, "end": 7.9, "s": 2}, {"text": "من السما.", "start": 7.9, "end": 8.87, "s": 2}, {"text": "عشان نور الشمس بياخد", "start": 8.87, "end": 10.287, "s": 3}, {"text": "حوالي ٨ دقايق", "start": 10.287, "end": 11.208, "s": 3}, {"text": "لحد ما يوصلنا،", "start": 11.208, "end": 12.42, "s": 3}, {"text": "والقمر أصلاً بينوّر", "start": 12.42, "end": 13.736, "s": 3}, {"text": "من نورها.", "start": 13.736, "end": 14.78, "s": 3}, {"text": "وفي نفس اللحظة،", "start": 14.78, "end": 15.91, "s": 4}, {"text": "الأرض هتبطّل تلف", "start": 15.91, "end": 17.058, "s": 4}, {"text": "حوالين الشمس،", "start": 17.058, "end": 18.21, "s": 4}, {"text": "وهتطلع ماشية في خط", "start": 18.21, "end": 19.449, "s": 4}, {"text": "مستقيم في الفضا.", "start": 19.449, "end": 20.97, "s": 4}, {"text": "بعد كام يوم،", "start": 20.97, "end": 21.98, "s": 5}, {"text": "الزرع الصغير هيبدأ يموت،", "start": 21.98, "end": 23.61, "s": 5}, {"text": "عشان مفيش نور", "start": 23.61, "end": 24.376, "s": 5}, {"text": "يعمل بيه أكله.", "start": 24.376, "end": 25.62, "s": 5}, {"text": "بعد أسبوع،", "start": 25.62, "end": 26.62, "s": 6}, {"text": "الدنيا كلها هتبقى", "start": 26.62, "end": 27.879, "s": 6}, {"text": "تحت الصفر،", "start": 27.879, "end": 28.84, "s": 6}, {"text": "أبرد من أي شتا", "start": 28.84, "end": 29.74, "s": 6}, {"text": "عشته في حياتك.", "start": 29.74, "end": 31.06, "s": 6}, {"text": "بعد كام شهر،", "start": 31.06, "end": 32.08, "s": 7}, {"text": "البحار هتبدأ تتجمد", "start": 32.08, "end": 33.326, "s": 7}, {"text": "من فوق.", "start": 33.326, "end": 34.23, "s": 7}, {"text": "بعد سنة،", "start": 34.23, "end": 35.11, "s": 8}, {"text": "الحرارة هتوصل لسالب سبعين،", "start": 35.11, "end": 37.08, "s": 8}, {"text": "والنيل نفسه هيبقى تلج.", "start": 37.08, "end": 39.05, "s": 8}, {"text": "والشجر الكبير؟", "start": 39.05, "end": 40.23, "s": 9}, {"text": "هيفضل عايش عشرات السنين،", "start": 40.23, "end": 42.16, "s": 9}, {"text": "عشان شايل أكل", "start": 42.16, "end": 43.093, "s": 9}, {"text": "جواه زي المخزن.", "start": 43.093, "end": 44.59, "s": 9}, {"text": "طب يعني كده", "start": 44.59, "end": 45.49, "s": 10}, {"text": "الحياة خلصت خالص؟", "start": 45.49, "end": 47.68, "s": 10}, {"text": "استنى ده الغريب جاي!", "start": 47.68, "end": 49.39, "s": 11}, {"text": "تحت التلج،", "start": 49.39, "end": 50.32, "s": 12}, {"text": "مية البحر هتفضل", "start": 50.32, "end": 51.361, "s": 12}, {"text": "سايلة آلاف السنين،", "start": 51.361, "end": 52.83, "s": 12}, {"text": "عشان التلج نفسه", "start": 52.83, "end": 53.776, "s": 12}, {"text": "هيدفّيها زي البطانية.", "start": 53.776, "end": 55.52, "s": 12}, {"text": "وفي قاع المحيط،", "start": 55.52, "end": 56.55, "s": 13}, {"text": "فيه كائنات عايشة جنب", "start": 56.55, "end": 57.75, "s": 13}, {"text": "براكين تحت المية،", "start": 57.75, "end": 58.99, "s": 13}, {"text": "عمرها ما شافت", "start": 58.99, "end": 59.812, "s": 13}, {"text": "الشمس أصلاً.", "start": 59.812, "end": 60.99, "s": 13}, {"text": "يعني لو الشمس اختفت…", "start": 60.99, "end": 62.93, "s": 14}, {"text": "ممكن متاخدش بالها خالص!", "start": 62.93, "end": 64.94, "s": 14}, {"text": "لو الشمس اختفت بكرة،", "start": 64.94, "end": 66.32, "s": 15}, {"text": "أول حاجة هتعملها في", "start": 66.32, "end": 67.485, "s": 15}, {"text": "الـ٨ دقايق دول إيه؟", "start": 67.485, "end": 69.03, "s": 15}, {"text": "اكتبهالي في الكومنتات.", "start": 69.03, "end": 70.37, "s": 15}, {"text": "الفهمان كسبان.", "start": 70.37, "end": 71.63, "s": 16}], "amp": [0.062, 0.327, 0.656, 0.883, 0.824, 1, 0.498, 0.273, 0.241, 0.289, 0.441, 0.944, 0.635, 0.766, 0.219, 0.261, 0.409, 0.321, 0.237, 0.123, 0.006, 0.42, 0.543, 0.148, 0.115, 0.321, 0.384, 0.164, 0.135, 0.209, 0.434, 0.208, 0.381, 0.684, 0.433, 0.163, 0.064, 0.007, 0.023, 0.048, 0.039, 0.034, 0.022, 0.026, 0.299, 0.366, 0.25, 0.215, 0.212, 0.155, 0.057, 0.207, 0.196, 0.494, 0.314, 0.26, 0.239, 0.42, 0.656, 0.